<?xml version="1.0" encoding="utf-8"?>
<!-- The game kit: what an exported game is linked from (design NewEngineBluePrint 11-b, RME_PLATFORM 5-a
     "書き出しを作り直す"). Compiles the layers that ship in games (base, core, platform, ui, game) and every
     plugin's runtime/, then tools/make_gamekit.ps1 groups the objects into one .lib for the core and one
     per plugin, next to the editor:  <exe folder>/GameKit/  (kit.json, lib/core.lib, lib/<author>/<name>/runtime.lib,
     the reflected types' files of each lib). The export links only the libs of the plugins a game uses.
     The same flags as the editor (RM.Common.props); the RMGameKit.lib this project also makes is not used. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{E5B2C3D4-7A81-4F62-9B0C-3D4E5F6A7B55}</ProjectGuid>
    <RootNamespace>RMGameKit</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="RM.Common.props" />
  </ImportGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- no debug information in the game's objects (no .pdb, no path of this PC through it) -->
      <DebugInformationFormat>None</DebugInformationFormat>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ProjectReference Include="..\tools\rmgen\rmgen.vcxproj">
      <Project>{D4A1F2B3-6C7E-4F80-9A1B-2C3D4E5F6A44}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <!-- Jolt Physics: built first, put into the kit's core.lib (make_gamekit.ps1 -ExtraCoreLibs) -->
    <ProjectReference Include="RMJolt.vcxproj">
      <Project>{B31C7F8A-3629-44F3-8AFD-E51A26C76E5B}</Project>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <!-- The layers that ship in games (layers.txt: "yes"): one object folder per source folder under k\ -->
  <ItemGroup>
    <ClCompile Include="base\*.cpp;core\**\*.cpp;platform\*.cpp;ui\*.cpp;game\*.cpp">
      <ObjectFileName>$(IntDir)k\%(RelativeDir)</ObjectFileName>
    </ClCompile>
    <!-- every plugin's runtime/ (not the scripts inside templates/): its objects under plugins\<author>\<name>\ -->
    <ClCompile Include="..\plugins\**\runtime\**\*.cpp" Exclude="..\plugins\**\templates\**">
      <ObjectFileName>$(IntDir)k\%(RelativeDir)</ObjectFileName>
    </ClCompile>
  </ItemGroup>
  <PropertyGroup>
    <RmGenOut>$(RMRoot)build\generated\$(ProjectName)\</RmGenOut>
    <RmGenRoots>--root "$(RMRoot)src" --root "$(RMRoot)plugins"</RmGenRoots>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Reflection: the same generator as the editor; only the files of shipping headers are compiled
       (not the editor's, not rm_all_types.cpp - an exported game's generated main lists its own types). -->
  <Target Name="RmGenKit" BeforeTargets="ClCompile">
    <Exec Command="&quot;$(OutDir)rmgen.exe&quot; --out &quot;$(RmGenOut).&quot; $(RmGenRoots)" StdOutEncoding="UTF-8" />
    <MakeDir Directories="$(IntDir)generated" />
    <ItemGroup>
      <ClCompile Include="$(RmGenOut)*.cpp" Exclude="$(RmGenOut)rm_all_types.cpp;$(RmGenOut)editor_*.cpp;$(RmGenOut)*_editor_*.cpp;$(RmGenOut)*_templates_*.cpp">
        <ObjectFileName>$(IntDir)generated\</ObjectFileName>
      </ClCompile>
    </ItemGroup>
  </Target>
  <Target Name="MakeGameKit" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RMRoot)tools\make_gamekit.ps1&quot; -Root &quot;$(RMRoot).&quot; -ObjDir &quot;$(IntDir).&quot; -GenDir &quot;$(RmGenOut).&quot; -Out &quot;$(OutDir)GameKit&quot; -LibExe &quot;$(VCToolsInstallDir)bin\Hostx64\x64\lib.exe&quot; -Crt $(RmCrt) -ExtraCoreLibs &quot;$(OutDir)RMJolt.lib&quot;" />
  </Target>
</Project>
