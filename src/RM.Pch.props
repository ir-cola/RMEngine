<?xml version="1.0" encoding="utf-8"?>
<!-- プリコンパイル済みヘッダー (2026-11-20): base/pch/StdPch.h (よく使う標準ライブラリのヘッダー) を
     プロジェクトごとに 1 回コンパイルし、全ソースの前に読み込む (強制インクルード。どのソースにも
     名前は書かない)。RM.Common.props の後に RM_Engine と RMTests が取り込む。RMGameKit は取り込まない
     (そのオブジェクトがゲームキットのライブラリになり、ゲームはヘッダーのオブジェクトも
     リンクする羽目になる)。RMBase・RMJolt・rmgen も取り込まない (小さいか、めったにビルドしない)。
     計測 (Debug): 1 ファイルのコンパイルが 0.3 〜 1.3 秒短くなった。 -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>base/pch/StdPch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)StdPch.pch</PrecompiledHeaderOutputFile>
      <ForcedIncludeFiles>base/pch/StdPch.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(MSBuildThisFileDirectory)base\pch\StdPch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
      <ObjectFileName>$(IntDir)pch\</ObjectFileName>
    </ClCompile>
  </ItemGroup>
</Project>
