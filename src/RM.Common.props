<?xml version="1.0" encoding="utf-8"?>
<!-- 全プロジェクト共通の設定。プロジェクトごとに専用の中間フォルダーを持つ
     (2 つのプロジェクトが 1 つの obj フォルダーを共有すると、前のエンジンで「定義済み」のリンクエラーが出た)。 -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <RMRoot>$(MSBuildThisFileDirectory)..\</RMRoot>
    <OutDir>$(RMRoot)build\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(RMRoot)build\obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <!-- 全プロジェクトのビルドに使う C++ ランタイム。ここに 1 回だけ書く。ゲームキットが書き出しに伝える
         (GameKit/kit.json) ので、ゲームの生成 main も同じ設定でコンパイルされる。 -->
    <RmCrt Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RmCrt>
    <RmCrt Condition="'$(Configuration)'!='Debug'">MultiThreaded</RmCrt>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- /FS: 並んで動くコンパイラー (UseMultiToolTask、../Directory.Build.props) が 1 つの PDB を共有する -->
      <AdditionalOptions>/utf-8 /Zc:__cplusplus /FS %(AdditionalOptions)</AdditionalOptions>
      <!-- JPH_*: Jolt Physics の設定 (RMJolt.vcxproj)。全プロジェクト・両方の構成で同じにする
           (Jolt はライブラリと、それを使うコードの設定が合っているか調べる)。結果が CPU によらない
           (同じ手順なら、どの PC でも同じ位置になる) ので、リプレイとテストが正しく保てる。
           DT_POLYREF64: Recast Navigation (RMRecast.vcxproj) の多角形の番号を 64 ビットに (区画の数と多角形の数の上限を広く)。
           Detour の型の大きさが変わるので、これも全プロジェクトで同じにする。 -->
      <PreprocessorDefinitions>NOMINMAX;WIN32_LEAN_AND_MEAN;UNICODE;_UNICODE;JPH_CROSS_PLATFORM_DETERMINISTIC;DT_POLYREF64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(MSBuildThisFileDirectory)third_party\JoltPhysics;$(MSBuildThisFileDirectory)third_party\RecastNavigation\Recast\Include;$(MSBuildThisFileDirectory)third_party\RecastNavigation\Detour\Include;$(MSBuildThisFileDirectory)third_party\RecastNavigation\DetourCrowd\Include;$(MSBuildThisFileDirectory)third_party\RecastNavigation\DetourTileCache\Include;$(RMRoot)plugins;$(RMRoot)resources;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(RMRoot)resources;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>$(RmCrt)</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>$(RmCrt)</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
</Project>
