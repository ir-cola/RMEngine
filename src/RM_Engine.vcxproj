  <ItemGroup>
    <ResourceCompile Include="..\resources\app.rc" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\resources\app.manifest" />
    <None Include="..\resources\lang\en.json" />
    <None Include="..\resources\updates.json" />
  </ItemGroup>
  <!-- Plugins (plugins/<author>/<name>/): every source file is built in (static linking).
       Listed by wildcard so adding a plugin never means editing this file. -->
  <ItemGroup>
    <!-- one object folder per source folder: two plugins may both have an editor/Register.cpp -->
    <ClCompile Include="..\plugins\**\*.cpp">
      <ObjectFileName>$(IntDir)plugins\%(RecursiveDir)</ObjectFileName>
    </ClCompile>
    <ClInclude Include="..\plugins\**\*.h" />
    <None Include="..\plugins\**\plugin.json" />
  </ItemGroup>
  <PropertyGroup>
    <RmGenOut>$(RMRoot)build\generated\$(ProjectName)\</RmGenOut>
    <RmGenRoots>--root "$(RMRoot)src" --root "$(RMRoot)plugins"</RmGenRoots>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="RM.Reflect.targets" />
  <!-- plugin.json files go next to the exe as Plugins/<author>/<name>/plugin.json (read at start-up). -->
  <Target Name="CopyPluginManifests" AfterTargets="Build">
    <ItemGroup>
      <PluginManifest Include="$(RMRoot)plugins\**\plugin.json;$(RMRoot)plugins\**\lang\*.json" />
      <LangFile Include="$(RMRoot)resources\lang\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginManifest)" DestinationFiles="@(PluginManifest->'$(OutDir)Plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- the core's translations: <exe>/Lang/en.json (editor/lang) -->
    <Copy SourceFiles="@(LangFile)" DestinationFolder="$(OutDir)Lang" SkipUnchangedFiles="true" />
    <!-- the list of the engine's files with their SHA-256, for the integrity check (Hub > オプション) -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(RMRoot)tools\make_filelist.ps1&quot; -Dir &quot;$(OutDir).&quot;" />
  </Target>
</Project>
