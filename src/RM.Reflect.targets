<?xml version="1.0" encoding="utf-8"?>
<!-- リフレクション (src/core/reflect/Reflect.h): rmgen がコンパイル前に $(RmGenRoots) 以下のヘッダーを
     読み、$(RmGenOut)*.reflect.cpp と rm_all_types.cpp を書く。それをここでコンパイルする。
     rmgen は文面が変わったときだけファイルを書き直すので、変わっていないヘッダーは再コンパイルされない。
     /p:RmGenSkip=true で生成を飛ばす (古い表でビルドが止まるかを確かめるのに使う)。 -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="RmGen" Condition="'$(RmGenSkip)' != 'true'">
    <Exec Command="&quot;$(OutDir)rmgen.exe&quot; --out &quot;$(RmGenOut).&quot; --skip-dir templates $(RmGenRoots)" StdOutEncoding="UTF-8" />
  </Target>
  <!-- FixupCLCompileOptions の前に (ClCompile だけでなく): 生成ファイルにも他と同じコンパイル設定が付く。
       UseMultiToolTask では「プリコンパイル済みヘッダーの後にコンパイル」(RM.Pch.props) - 2026-11-20。
       Visual Studio のデザイン時ビルド (IntelliSense) では行わない。 -->
  <Target Name="RmGenCompile" BeforeTargets="FixupCLCompileOptions;ClCompile" DependsOnTargets="RmGen" Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(IntDir)generated" />
    <ItemGroup>
      <ClCompile Include="$(RmGenOut)*.cpp">
        <ObjectFileName>$(IntDir)generated\</ObjectFileName>
      </ClCompile>
    </ItemGroup>
  </Target>
</Project>
